# Copy to .env and adjust. .env is gitignored; never commit real credentials.

# Docker Compose (PostgreSQL container). These are local development defaults only.
POSTGRES_USER=agentfleet
POSTGRES_PASSWORD=agentfleet
POSTGRES_DB=agentfleet
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql+asyncpg://agentfleet:agentfleet@localhost:5433/agentfleet
# Tests use a separate database so they never touch development data. It is created on first run.
TEST_DATABASE_URL=postgresql+asyncpg://agentfleet:agentfleet@localhost:5433/agentfleet_test
